# MixSight env vars — copy to .env and fill in.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://mixsight:mixsight@localhost:5432/mixsight_dev
# Alembic uses the same asyncpg driver via run_sync — no separate sync URL needed.

# --- Redis (Phase 1c+, used for jobs / cache) ---
REDIS_URL=redis://localhost:6379/0

# --- Clerk auth ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# --- Anthropic (default workspace key) ---
ANTHROPIC_API_KEY=sk-ant-...

# --- Secrets encryption (rotate via key_version) ---
MIXSIGHT_FERNET_KEY=base64-encoded-32-byte-key
MIXSIGHT_FERNET_KEY_VERSION=1
ANONYMIZATION_SALT=random-long-string

# --- Stripe (Phase 1c+) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Sentry (recommended from Phase 1a) ---
SENTRY_DSN_API=
SENTRY_DSN_WEB=

# --- Connector OAuth client credentials ---
# Meta (file API approval Phase 1a week 1; expect 1-3 week wait)
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=http://localhost:3000/connectors/meta/callback

# Google Ads (file developer token Phase 1a week 1)
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_REDIRECT_URI=http://localhost:3000/connectors/google_ads/callback

# Google Analytics (shares Google OAuth project; separate scopes)
GA4_CLIENT_ID=
GA4_CLIENT_SECRET=
GA4_REDIRECT_URI=http://localhost:3000/connectors/ga4/callback

# TikTok (file business app review Phase 1a week 1)
TIKTOK_APP_ID=
TIKTOK_APP_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/connectors/tiktok/callback

# --- App config ---
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000
ENVIRONMENT=development  # development | staging | production

# --- Local demo harness (dev only; leave blank in CI) ---
# Attach the NB EMEA seed data to your real Clerk org so a signed-in user can
# load the pacing surface. Sign in once, then read the org id from the
# JIT-provisioned Organization row (or the Clerk dashboard).
SEED_CLERK_ORG_ID=
# The pacing path the seed script prints; links the pacing view from the home
# page (e.g. /clients/<uuid>/markets/<uuid>/pacing).
NEXT_PUBLIC_DEMO_PACING_PATH=
