{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/week-end-gate.mjs",
            "description": "Block marking a week complete in CURRENT_PHASE.md until the /week-end gates (quality bar + code-review + refactor + tests + SHIPPED entry) are satisfied"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/tenancy-check.mjs",
            "description": "Flag new FastAPI routes that take client_id without enforce_client_access"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/migration-check.mjs",
            "description": "Verify any new Alembic migration follows §6.2 conventions"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/llm-fallback-check.mjs",
            "description": "Flag any new messages.create call without an explicit surface-specific fallback"
          },
          {
            "type": "command",
            "command": "node .claude/hooks/audit-log-check.mjs",
            "description": "Flag patterns that may bypass the SQLAlchemy audit log hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/phase-reminder.sh",
            "description": "Inject CURRENT_PHASE.md state into the conversation context"
          }
        ]
      }
    ]
  }
}
