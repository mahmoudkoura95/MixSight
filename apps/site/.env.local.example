# Copy this file to .env.local and fill in values.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser bundle.

# Web3Forms — handles the /contact form submissions.
# 1. Go to https://web3forms.com/
# 2. Enter hello@mixsight.ai → they email you an access key.
# 3. Paste the key below.
# If left blank, the contact form falls back to opening the user's email client (mailto:).
NEXT_PUBLIC_WEB3FORMS_KEY=

# Pitch page (/pitch) — client-side password gate.
# Generate hash with:  node scripts/generate-pitch-hash.mjs <username> <password>
# Paste the SHA-256 hex digest below. If left blank, the gate rejects all attempts.
NEXT_PUBLIC_PITCH_PASSWORD_HASH=
